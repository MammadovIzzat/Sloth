#!/bin/sh
# Sloth post-installation.
set -e

DATA_DIR=/var/lib/sloth
USERNAME=sloth

case "$1" in
    configure)
        # A dedicated system account: the service holds engagement data and
        # spawns scanners, so it should not run as root or as a login user.
        if ! getent passwd "$USERNAME" >/dev/null; then
            adduser --system --group --quiet \
                    --home "$DATA_DIR" --no-create-home \
                    --gecos "Sloth" "$USERNAME"
        fi

        mkdir -p "$DATA_DIR/runs" "$DATA_DIR/screenshots"
        chown -R "$USERNAME:$USERNAME" "$DATA_DIR"
        # Results and the session key live here; keep them off other accounts.
        chmod 0750 "$DATA_DIR"

        if [ -d /etc/sloth ]; then
            chmod 0755 /etc/sloth
        fi

        echo ""
        echo "Sloth installed."
        echo "  Start it:  systemctl enable --now sloth"
        echo "  Open:      http://127.0.0.1:9998  (first visit creates your account)"
        echo "  Configure: /etc/sloth/sloth.conf"
        echo ""
        ;;
    abort-upgrade|abort-remove|abort-deconfigure)
        ;;
    *)
        echo "postinst called with unknown argument \`$1'" >&2
        exit 1
        ;;
esac

#DEBHELPER#

if [ -d /run/systemd/system ]; then
    systemctl daemon-reload >/dev/null 2>&1 || true
    if [ "$1" = "configure" ] && systemctl is-enabled sloth >/dev/null 2>&1; then
        systemctl restart sloth >/dev/null 2>&1 || true
    fi
fi

exit 0
