#!/bin/sh
set -e

DATA_DIR=/var/lib/sloth
USERNAME=sloth

case "$1" in
    remove)
        if [ -d /run/systemd/system ]; then
            systemctl daemon-reload >/dev/null 2>&1 || true
        fi
        ;;
    purge)
        # Scan results are engagement data, so they only go on an explicit
        # purge — never on a plain remove or an upgrade.
        rm -rf "$DATA_DIR"
        rm -rf /etc/sloth
        if getent passwd "$USERNAME" >/dev/null; then
            deluser --quiet --system "$USERNAME" >/dev/null 2>&1 || true
        fi
        if getent group "$USERNAME" >/dev/null; then
            delgroup --quiet --system "$USERNAME" >/dev/null 2>&1 || true
        fi
        if [ -d /run/systemd/system ]; then
            systemctl daemon-reload >/dev/null 2>&1 || true
        fi
        ;;
    upgrade|failed-upgrade|abort-install|abort-upgrade|disappear)
        ;;
    *)
        echo "postrm called with unknown argument \`$1'" >&2
        exit 1
        ;;
esac

exit 0
