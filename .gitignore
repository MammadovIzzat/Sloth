# Engagement data — never commit. This repository is public, and everything
# below is either a client's scan results or a credential.

# Results database: projects, findings, and the users table holding password
# and API-token hashes.
scans.db
scans.db-wal
scans.db-shm
*.sqlite
*.sqlite3

# Per-task working directories. Contains .secret (the session signing key) and
# masscan paused.conf files, which record the scanning host's adapter address
# and the target ranges.
runs/

# TLS certificate and private key. From a checkout the default path is ./tls/,
# and a private key must never be committed. Covers a user-supplied pair left
# in the tree too.
tls/
*.pem
*.key

# Screenshots of client web services captured during scans. Root-anchored on
# purpose: an unanchored 'screenshots/' would also swallow docs/screenshots/,
# which holds the README images.
/screenshots/

# Recovered scan data and stray masscan state from earlier runs.
legacy_scans_backup.json
restore_legacy_scans.py
paused.conf

# Build output.
dist/
__pycache__/
*.py[cod]

# Local editor/tool state.
.cls
.claude/
.venv/
venv/
*.log

# Output written by other tools run from this directory. Named after live
# hosts, so it is engagement data whatever produced it.
reports/
# Electron-branch build artifacts, not part of the web build.
node_modules/
packaging/arch/
